# Copy to integration-tests.env (gitignored) and fill in.
# Used by /verify-decision when a decision needs the IntegrationTests rung.
# Never commit the filled file. Never put these values in Mem0 or chat logs.

# Homeserver name or base URL typed into Change Server (e.g. matrix.org).
# Leave empty to keep the app default (matrix.org) without retyping.
INTEGRATION_TESTS_HOST=matrix.org

# Localpart or email for the MAS / OIDC login form ("Username or Email").
INTEGRATION_TESTS_USERNAME=

# Password for that account.
INTEGRATION_TESTS_PASSWORD=
